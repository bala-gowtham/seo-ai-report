# Set these in Netlify: Project configuration > Environment variables.
# Scope must include Builds, Functions, and Runtime for production.

N8N_BASE_URL=https://balsgowtham-n8n.hf.space
N8N_CLIENTS_WEBHOOK_PATH=/webhook/seo-report-clients
N8N_PARENT_WEBHOOK_PATH=/webhook/seo-report-orchestrator
N8N_AI_WEBHOOK_PATH=/webhook/seo-report-ai-assistant
N8N_CACHE_WEBHOOK_PATH=/webhook/seo-report-snapshot-cache

SEO_CACHE_SCHEMA=parent-v5-compact-gsc1

# Required. Must exactly match SEO_REPORT_SHARED_SECRET in Hugging Face.
# Never commit the real value.
SEO_REPORT_SHARED_SECRET=replace-with-the-huggingface-shared-secret

# Required. This protects the internal background refresh worker.
# Use a different value from SEO_REPORT_SHARED_SECRET.
SEO_INTERNAL_REFRESH_TOKEN=replace-with-a-different-long-random-secret

# Temporary migration compatibility only.
# Keep this until all Phase 5.3 tests pass, then remove it from Netlify.
N8N_PROXY_SECRET=replace-with-the-existing-legacy-proxy-secret

# Optional custom production origin, for example:
# SEO_ALLOWED_ORIGIN=https://your-site.netlify.app
SEO_ALLOWED_ORIGIN=
